{
 "_about": "Which models restore Wounds, read from the card text. 'self' heals the unit the model is (or is attached to); 'other' heals other friendly units. 'amount' is Wounds per occurrence, 'rank' adds the average extra from '+1 Wound for each destroyed rank', 'when' picks a row of the 'when' table below. See README.md.",
 "rankBonus": 0.5,
 "when": {
  "activate": {
   "label": "Each time this unit activates",
   "perRound": 1
  },
  "attack": {
   "label": "Each time this unit makes a Melee Attack (or Ranged, where the card says so)",
   "perRound": 1
  },
  "attackHit": {
   "label": "After an attack that dealt Wounds or destroyed a rank",
   "perRound": 0.75
  },
  "morale": {
   "label": "When a unit passes a Morale Test",
   "perRound": 0.5
  },
  "enemyPanic": {
   "label": "When an engaged enemy fails a Panic Test",
   "perRound": 0.5
  },
  "retreat": {
   "label": "After completing a Retreat Action",
   "perRound": 0.25
  },
  "condition": {
   "label": "When an enemy gains a Condition token",
   "perRound": 0.5
  },
  "activateCtl": {
   "label": "On activation, but only while a Control condition holds",
   "perRound": 0.5
  },
  "token": {
   "label": "Costs a Faith, Pillage or Order token",
   "perRound": 0.5
  },
  "order": {
   "label": "An Order (uses an Order token)",
   "perRound": 0.5
  },
  "zone": {
   "label": "When an NCU claims a zone (it gives up the zone's normal effect)",
   "perRound": 0.5
  },
  "oncePerGame": {
   "label": "Once per game",
   "perRound": 0.167
  }
 },
